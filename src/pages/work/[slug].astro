---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FactsStrip from '../../components/FactsStrip.astro';
import Picture from '../../components/Picture.astro';
import { caseEyebrow, getCaseStudies, nextCaseStudy, type CaseStudy } from '../../lib/work';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const all = await getCaseStudies();
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, next: nextCaseStudy(all, entry) } }));
}

const { entry, next } = Astro.props as { entry: CaseStudy; next: CaseStudy };
const { title, hook, intro, summary, role, timeline, status, liveUrl, hero, screenshots } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={title} description={summary}>
  <article>
    <header class="container cs-intro">
      <a class="cs-back" href="/#work">← All work</a>
      <p class="eyebrow">{caseEyebrow(entry)}</p>
      <h1 class="cs-title">{title}</h1>
      <p class="cs-hook">{hook}</p>
      <p class="cs-lede">{intro}</p>
    </header>

    <div class="container">
      <FactsStrip role={role} timeline={timeline} status={status} liveUrl={liveUrl} />
    </div>

    <div class="container cs-hero">
      <Picture
        picture={hero}
        aspect="16 / 9"
        widths={[800, 1200, 1600, 2240]}
        sizes="(max-width: 1160px) calc(100vw - 48px), 1112px"
        eager
      />
    </div>

    <div class="container cs-body">
      <Content />
    </div>

    {
      screenshots.length > 0 && (
        <div class="container cs-shots">
          {screenshots.map((shot) => (
            <Picture picture={shot} widths={[600, 1100]} sizes="(max-width: 760px) calc(100vw - 48px), 540px" />
          ))}
        </div>
      )
    }
  </article>

  {
    next.id !== entry.id && (
      <nav class="container cs-next" aria-label="Next case study">
        <a href={`/work/${next.id}/`}>
          <span class="eyebrow">Next case study</span>
          <span class="cs-next__title">
            {next.data.title} <span class="cs-next__arrow" aria-hidden="true">→</span>
          </span>
        </a>
      </nav>
    )
  }
</BaseLayout>

<style>
  .cs-intro {
    display: grid;
    justify-items: start;
    padding-block: 32px 56px;
  }
  .cs-back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 40px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }
  .cs-title {
    margin-top: 16px;
    font-size: clamp(56px, 10vw, 96px);
    line-height: 1;
  }
  .cs-hook {
    max-width: 24em;
    margin-top: 24px;
    font-family: var(--font-serif);
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.2;
    color: var(--text);
    text-wrap: balance;
  }
  .cs-lede {
    max-width: 640px;
    margin-top: 24px;
    font-size: 18px;
  }
  .cs-hero {
    margin-block: 56px 32px;
  }
  .cs-body {
    margin-top: 24px;
  }
  .cs-shots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: 24px;
  }
  .cs-next {
    margin-top: 96px;
  }
  .cs-next a {
    display: grid;
    gap: 12px;
    padding-block: 48px;
    border-top: 1px solid var(--border);
    text-decoration: none;
  }
  .cs-next__title {
    font-family: var(--font-serif);
    font-size: clamp(40px, 6vw, 64px);
    line-height: 1.05;
    color: var(--text);
  }
  .cs-next__arrow {
    color: var(--accent);
  }
  .cs-next a:hover .cs-next__title {
    color: var(--accent-hover);
  }
  @media (max-width: 760px) {
    .cs-intro {
      padding-block: 16px 40px;
    }
    .cs-back {
      margin-bottom: 24px;
    }
    .cs-hero {
      margin-block: 40px 16px;
    }
    .cs-shots {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
  }
</style>
