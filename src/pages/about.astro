---
// Placeholder About page: reads from about.md to prove the collection works.
// Replaced by the real About layout in step 7.
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const about = await getEntry('about', 'about');
if (!about) throw new Error('Missing src/content/pages/about.md');
---

<BaseLayout title={about.data.title}>
  <section class="container placeholder">
    <h1>{about.data.heading}</h1>
    <p>{about.data.intro}</p>
  </section>
</BaseLayout>

<style>
  .placeholder {
    display: grid;
    gap: 24px;
    padding-block: 64px;
  }
  h1 {
    font-size: clamp(44px, 7vw, 76px);
  }
  p {
    max-width: 60ch;
  }
</style>
