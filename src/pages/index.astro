---
// Placeholder home page: reads from the content collections to prove they
// work. Replaced by the real home page layout in step 4.
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';
import { caseNumber, getCaseStudies } from '../lib/work';

const home = await getEntry('home', 'home');
if (!home) throw new Error('Missing src/content/pages/home.md');
const { Content: Bio } = await render(home);
const work = await getCaseStudies();
---

<BaseLayout>
  <section class="container placeholder">
    <p class="eyebrow eyebrow--accent">Under construction</p>
    <h1>{home.data.headline} <em>{home.data.headlineAccent}</em></h1>
    <div class="bio"><Bio /></div>
    <div class="placeholder__buttons">
      <a class="btn btn--primary" href={`mailto:${site.email}`}>Email me</a>
      <a class="btn btn--secondary" href={site.resume}>{home.data.resumeLabel}</a>
    </div>
    <h2 class="eyebrow">{home.data.workHeading} · {home.data.workYear}</h2>
    <ol class="work-list">
      {work.map((entry) => (
        <li>
          <span class="work-list__num">{caseNumber(entry.data.order)}</span> {entry.data.title}: {entry.data.summary}
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .placeholder {
    display: grid;
    gap: 24px;
    padding-block: 64px;
  }
  h1 {
    max-width: 16ch;
    font-size: clamp(44px, 7vw, 76px);
  }
  h1 em {
    color: var(--accent);
  }
  .bio {
    max-width: 60ch;
  }
  .placeholder__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .work-list {
    display: grid;
    gap: 12px;
    padding: 0;
    list-style: none;
  }
  .work-list__num {
    font-family: var(--font-serif);
    color: var(--accent);
  }
</style>
