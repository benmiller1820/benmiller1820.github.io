---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkRow from '../components/WorkRow.astro';
import { site } from '../lib/site';
import { getCaseStudies } from '../lib/work';

const home = await getEntry('home', 'home');
if (!home) throw new Error('Missing src/content/pages/home.md');
const { Content: Bio } = await render(home);
const work = await getCaseStudies();
const { headline, headlineAccent, resumeLabel, linkedinLabel, workHeading, workYear } = home.data;
---

<BaseLayout title={home.data.title}>
  <section class="container hero">
    <h1 class="hero__headline">{headline} <em>{headlineAccent}</em></h1>
    <div class="hero__row">
      <div class="hero__bio"><Bio /></div>
      <div class="hero__actions">
        <a class="btn btn--secondary" href={site.resume} target="_blank" rel="noopener">{resumeLabel}<span class="sr-only"> (opens in new tab)</span></a>
        <a class="btn btn--secondary" href={site.linkedin}>{linkedinLabel}</a>
      </div>
    </div>
  </section>

  <section class="container work" id="work" aria-labelledby="work-heading">
    <div class="work__header">
      <h2 class="eyebrow" id="work-heading">{workHeading}</h2>
      <p class="eyebrow">{workYear}</p>
    </div>
    <ol class="work__list">
      {work.map((entry) => <WorkRow entry={entry} />)}
    </ol>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 72px 112px;
  }
  .hero__headline {
    max-width: 19em;
    font-size: clamp(44px, 6.4vw, 76px);
    line-height: 1.05;
  }
  .hero__headline em {
    color: var(--accent);
  }
  .hero__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px 64px;
    margin-top: 48px;
  }
  .hero__bio {
    flex: 1 1 420px;
    max-width: 620px;
    font-size: 18px;
  }
  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .work {
    scroll-margin-top: 24px;
  }
  .work__header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }
  .work__list {
    padding: 0;
    list-style: none;
  }
  @media (max-width: 760px) {
    .hero {
      padding-block: 48px 72px;
    }
    .hero__bio {
      font-size: 17px;
    }
  }
</style>
