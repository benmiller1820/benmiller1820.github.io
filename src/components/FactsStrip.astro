---
// Role / Timeline / Status / Try it, from case study frontmatter.
import { liveHref } from '../lib/work';

interface Props {
  role: string;
  timeline: string;
  status: string;
  liveUrl: string;
}

const { role, timeline, status, liveUrl } = Astro.props;
const href = liveHref(liveUrl);
const linkText = href ? `${new URL(href).hostname.replace(/^www\./, '')} ↗` : liveUrl;
---

<dl class="facts">
  <div class="facts__cell">
    <dt class="eyebrow">Role</dt>
    <dd>{role}</dd>
  </div>
  <div class="facts__cell">
    <dt class="eyebrow">Timeline</dt>
    <dd>{timeline}</dd>
  </div>
  <div class="facts__cell">
    <dt class="eyebrow">Status</dt>
    <dd>{status}</dd>
  </div>
  <div class="facts__cell">
    <dt class="eyebrow">Try it</dt>
    <dd>{href ? <a href={href} rel="noopener">{linkText}</a> : linkText}</dd>
  </div>
</dl>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: 1px solid var(--border);
  }
  .facts__cell {
    padding: 24px;
    border-left: 1px solid var(--border);
  }
  .facts__cell:first-child {
    padding-left: 0;
    border-left: 0;
  }
  dd {
    margin: 8px 0 0;
    color: var(--text);
  }
  dd a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-block: -10px;
  }
  @media (max-width: 860px) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .facts__cell:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
    .facts__cell:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }
  @media (max-width: 480px) {
    .facts {
      grid-template-columns: minmax(0, 1fr);
    }
    .facts__cell {
      padding: 18px 0;
      border-left: 0;
    }
    .facts__cell + .facts__cell {
      border-top: 1px solid var(--border);
    }
  }
</style>
